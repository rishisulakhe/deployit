# -----------------------------------------------------------------------------
# Vercel Clone — environment variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in values.
#
# TWO MODES:
#   1. LOCAL-ONLY: S3_BUCKET="local", ECS_SUBNETS=""
#      - Builds run as local subprocesses
#      - Artifacts saved to /tmp/vercel-clone-artifacts/
#      - Zero AWS cost
#
#   2. AWS MODE: Run scripts/setup-aws.sh, then fill in values below
#      - Builds run on ECS Fargate
#      - Artifacts uploaded to S3
#      - Low cost (~$1-2/day)
# -----------------------------------------------------------------------------

# --- Database (PostgreSQL) ---
# Local docker-compose Postgres
DATABASE_URL="postgresql://vercel:vercel@localhost:5432/vercel?schema=public"

# --- Redis (queue + cache) ---
REDIS_URL="redis://localhost:6379"
BUILD_QUEUE="build_queue"
BUILD_DLQ="build_dlq"

# --- api-server ---
PORT=3001
LOG_LEVEL="debug"

# --- Orchestrator ---
ORCHESTRATOR_PORT=3003

# --- GitHub OAuth ---
# Create at: GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
# Homepage URL: http://localhost:3000
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
NEXT_PUBLIC_GITHUB_CLIENT_ID=""
NEXT_PUBLIC_GITHUB_REDIRECT_URI="http://localhost:3000/api/auth/callback/github"
GITHUB_REDIRECT_URI="http://localhost:3000/api/auth/callback/github"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# --- AWS (optional) ---
# Leave empty if you ran `aws configure` — SDK reads ~/.aws/credentials
AWS_REGION="ap-south-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- S3 build artifacts ---
# LOCAL MODE: set to "local" → artifacts written to /tmp/vercel-clone-artifacts/
# AWS MODE: set to bucket name from scripts/setup-aws.sh
S3_ARTIFACTS_BUCKET="local"
S3_ARTIFACTS_PREFIX="projects"

# --- ECS Fargate ---
# LOCAL MODE: leave empty → builds run as subprocesses
# AWS MODE: fill in from scripts/setup-aws.sh output
ECS_CLUSTER="vercel-clone"
ECS_BUILD_TASK_DEFINITION="vercel-clone-build-agent"
ECS_BUILD_TASK_SUBNETS=""
ECS_BUILD_TASK_SECURITY_GROUPS=""
ECS_BUILD_CONTAINER_NAME="build-agent"
ECS_BUILD_TIMEOUT_SECONDS="900"
ECS_BUILD_MAX_RETRIES="3"

# --- edge-proxy ---
EDGE_PROXY_PORT="8000"
# LOCAL MODE: leave empty → serves from /tmp/vercel-clone-artifacts/
# AWS MODE: leave empty → serves directly from S3
EDGE_PROXY_BACKEND_BASE_URL=""
EDGE_PROXY_CACHE_TTL="120"

# --- Dashboard ---
NEXT_PUBLIC_EDGE_PROXY_URL="http://localhost:8000"

# --- Observability ---
PROMETHEUS_PORT="9090"
GRAFANA_PORT="3002"
