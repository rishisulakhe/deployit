# -----------------------------------------------------------------------------
# Vercel Clone — environment variables
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Each service also reads its own `.env` for service-specific overrides.
#
# TWO MODES:
#   1. LOCAL-ONLY (no AWS, no Terraform): S3_BUCKET="local", ECS_SUBNETS=""
#      Builds run as subprocesses, artifacts saved to /tmp/, edge-proxy
#      serves from local filesystem. Zero AWS cost.
#   2. AWS (terraform applied): S3_BUCKET=<real bucket>, ECS_SUBNETS=<ids>
#      Builds run on ECS Fargate, artifacts uploaded to real S3, edge-proxy
#      proxies to CloudFront. Costs ~$3-5/day.
# -----------------------------------------------------------------------------

# --- Database (PostgreSQL) [P0] ---
# Local dev: docker-compose Postgres. Prod: RDS endpoint from Terraform outputs.
DATABASE_URL="postgresql://vercel:vercel@localhost:5432/vercel?schema=public"

# --- Redis (queue + log pub/sub + cache) [P0] ---
# Local dev: docker-compose Redis. Prod: ElastiCache endpoint from Terraform.
REDIS_URL="redis://localhost:6379"
# ElastiCache Redis for ECS build-agent (reachable from within VPC).
# Only needed in AWS mode (when ECS_BUILD_TASK_SUBNETS is set).
ECS_REDIS_URL=""
BUILD_QUEUE="build_queue"
BUILD_DLQ="build_dlq"

# --- api-server [P0] ---
PORT=3001
LOG_LEVEL="debug"

# --- Orchestrator metrics server [P2] ---
ORCHESTRATOR_PORT=3003

# --- GitHub OAuth [P2] ---
# Create at: GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# NEXT_PUBLIC_ variants are exposed to the browser by Next.js (client-side).
# Must match GITHUB_CLIENT_ID above. Without these, the login button breaks.
NEXT_PUBLIC_GITHUB_CLIENT_ID=""
NEXT_PUBLIC_GITHUB_REDIRECT_URI="http://localhost:3000/api/auth/callback/github"
GITHUB_REDIRECT_URI="http://localhost:3000/api/auth/callback/github"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# --- AWS [P1, P2] ---
AWS_REGION="ap-south-2"
# Leave both empty if you ran `aws configure` — the AWS SDK v3 default
# credential provider chain automatically reads ~/.aws/credentials.
# In prod, leave empty too — the ECS task IAM role handles auth.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- S3 build artifacts [P1, P2] ---
# LOCAL MODE: set to "local" → artifacts written to /tmp/vercel-clone-artifacts/
# AWS MODE: run `terraform output s3_artifacts_bucket_name` from infra/terraform/
S3_ARTIFACTS_BUCKET="local"
S3_ARTIFACTS_PREFIX="projects"

# --- CloudFront CDN in front of S3 [P1] ---
# AWS MODE: run `terraform output cloudfront_distribution_domain`
# LOCAL MODE: leave empty
CLOUDFRONT_DOMAIN=""

# --- ECS Fargate build orchestrator [P1, P2] ---
ECS_CLUSTER="vercel-clone-dev"
ECS_BUILD_TASK_DEFINITION="vercel-clone-dev-build-agent"
# LOCAL MODE: leave EMPTY → builds run as local subprocesses (no AWS needed)
# AWS MODE: comma-separated private subnet IDs from `terraform output private_subnet_ids`
ECS_BUILD_TASK_SUBNETS=""
# AWS MODE: ECS task security group ID from Terraform
ECS_BUILD_TASK_SECURITY_GROUPS=""
ECS_BUILD_CONTAINER_NAME="build-agent"
ECS_BUILD_TIMEOUT_SECONDS="900"
ECS_BUILD_MAX_RETRIES="3"

# --- edge-proxy [P0] ---
EDGE_PROXY_PORT="8000"
# LOCAL MODE: leave empty → edge-proxy serves from /tmp/vercel-clone-artifacts/
# AWS MODE: "https://<cloudfront_distribution_domain>"
EDGE_PROXY_BACKEND_BASE_URL=""
EDGE_PROXY_CACHE_TTL="120"

# --- Orchestration KMS encryption [P1, P2] ---
# LOCAL MODE: leave empty → passthrough encryption (dev: prefix, no real crypto)
# AWS MODE: run `terraform output kms_key_id`
KMS_KEY_ID=""

# --- Dashboard [P3] ---
# URL where the edge-proxy is accessible from the browser
NEXT_PUBLIC_EDGE_PROXY_URL="http://localhost:8000"

# --- Observability [P1, P4] ---
PROMETHEUS_PORT="9090"
GRAFANA_PORT="3002"