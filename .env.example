# -----------------------------------------------------------------------------
# Vercel Clone — environment variables
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Each service also reads its own `.env` for service-specific overrides.
# Per-phase variables are tagged [P0]/[P1]/[P2] for the build sequence.
# -----------------------------------------------------------------------------

# --- Database (PostgreSQL) [P0] ---
# Local dev: see docker-compose.yml. Prod: RDS endpoint from Terraform outputs.
DATABASE_URL="postgresql://vercel:vercel@localhost:5432/vercel?schema=public"

# --- Redis (queue + log pub/sub + cache) [P0] ---
# Local dev: see docker-compose.yml. Prod: ElastiCache endpoint from Terraform.
REDIS_URL="redis://localhost:6379"
BUILD_QUEUE="build_queue"
BUILD_DLQ="build_dlq"

# --- api-server [P0] ---
PORT=3001
LOG_LEVEL="debug"

# --- GitHub OAuth [P2] ---
# Used by api-server to exchange the code GitHub returns to the dashboard.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# NEXT_PUBLIC_ variants are exposed to the browser by Next.js (client-side).
# Must match GITHUB_CLIENT_ID above. Without these, the login button breaks.
NEXT_PUBLIC_GITHUB_CLIENT_ID=""
NEXT_PUBLIC_GITHUB_REDIRECT_URI="http://localhost:3000/api/auth/callback/github"
# The dashboard's auth callback URL, registered on the GitHub OAuth app.
GITHUB_REDIRECT_URI="http://localhost:3000/api/auth/callback/github"
# Session/JWT signing secret for NextAuth on the dashboard.
NEXTAUTH_SECRET=""

# --- AWS [P1, P2] ---
# Used by build-agent (task role in prod, env in local dev) and edge-proxy.
AWS_REGION="ap-south-2"
# Leave both empty if you ran `aws configure` — the AWS SDK v3 default
# credential provider chain automatically reads ~/.aws/credentials.
# In prod, leave empty too — the ECS task IAM role handles auth.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- S3 build artifacts [P1, P2] ---
# Bucket name and prefix where build-agent uploads builds; edge-proxy reads from here.
# Local dev: set to "local" to write artifacts to /tmp/vercel-clone-artifacts/
# Prod: Terraform output s3_artifacts_bucket_name
S3_ARTIFACTS_BUCKET="local"
S3_ARTIFACTS_PREFIX="projects"

# --- CloudFront CDN in front of S3 [P1] ---
# When set, edge-proxy proxies to CloudFront instead of S3 directly.
CLOUDFRONT_DOMAIN=""

# --- ECS Fargate build orchestrator [P1, P2] ---
ECS_CLUSTER="vercel-clone-dev"
ECS_BUILD_TASK_DEFINITION="vercel-clone-build-agent-dev"
ECS_BUILD_TASK_SUBNETS=""
ECS_BUILD_TASK_SECURITY_GROUPS=""
ECS_BUILD_CONTAINER_NAME="build-agent"
ECS_BUILD_TIMEOUT_SECONDS="900"
ECS_BUILD_MAX_RETRIES="3"

# --- edge-proxy [P0] ---
EDGE_PROXY_PORT="8000"
# Base URL edge-proxy reverses to (CloudFront in prod, S3 direct in dev).
EDGE_PROXY_BACKEND_BASE_URL=""
# Cache TTL (seconds) for subdomain -> project lookups in Redis.
EDGE_PROXY_CACHE_TTL="120"

# --- Orchestration KMS encryption [P1, P2] ---
# KMS key used by api-server to encrypt user tokens + project env vars at rest.
KMS_KEY_ID=""

# --- Observability [P1, P4] ---
PROMETHEUS_PORT="9090"
GRAFANA_PORT="3002"

# --- Orchestrator metrics server [P2] ---
# Must not conflict with Grafana (3002 above).
ORCHESTRATOR_PORT="3003"